# .NET build outputs
bin/
obj/

# User/local IDE files
.idea/
.vs/
.vscode/
*.user
*.suo
.env
.env.*
!deploy/.env.example
# #458 — VITE_APP_VERSION only, a public string baked into the client bundle
# regardless of whether it's committed; release-please bumps it in lockstep
# with version.txt (see release-please-config.json's extra-files).
!web/.env.production
appsettings.Development.local.json

# OS/editor noise
.DS_Store
Thumbs.db
.claude/worktrees/
node_modules/

# Database dumps/backups — never commit real data (#317)
*.sql
*.sql.gz
*.dump
*.dump.gz
*.bak
*.backup

# Private-key and container-secret formats — never commit real key material
# (#317). Test/CI credentials are generated at runtime instead (see
# tests/Cluckwork.Api.IntegrationTests/Infrastructure/CluckworkWebApplicationFactory.cs).
*.pem
*.key
*.p12
*.pfx

# Generated test-run reports. `dotnet test --logger trx` writes these under a
# TestResults/ folder next to the project; nothing in the repo consumes them,
# and they embed the developer's machine name and absolute home path.
TestResults/
*.trx

# Generated coverage report output (#776) — tools/coverage/collect.sh writes
# here; nothing in the repo consumes it and it is regenerated on every run.
coverage-out/

.agents/skills/*
.claude/skills/*
.codex/skills/*
# verify is Cluckwork's own skill, not an installed one: it knows this repo's
# stacks and ports. Its tree lives at tools/verify/ (agent-agnostic) and each
# agent's skill directory carries a symlink to it, tracked here so every
# runtime discovers the same SKILL.md. The parent rules end in /* on purpose:
# git cannot re-include a file under an excluded directory.
!.agents/skills/verify
!.claude/skills/verify
!.codex/skills/verify
skills-lock.json
scratchpad/

## Spec Kit tooling (regenerated by `specify init`; keep only shared governance artifacts)
.specify/*
!.specify/.gitignore
!.specify/init-options.json
!.specify/integrations/
!.specify/memory/
!.specify/scripts/
!.specify/templates/
!.specify/workflows/
