# .NET build outputs
bin/
obj/

# User/local IDE files
.idea/
.vs/
.vscode/
*.user
*.suo
.env
.env.*
!deploy/.env.example
# #458 — VITE_APP_VERSION only, a public string baked into the client bundle
# regardless of whether it's committed; release-please bumps it in lockstep
# with version.txt (see release-please-config.json's extra-files).
!web/.env.production
appsettings.Development.local.json

# OS/editor noise
.DS_Store
Thumbs.db
.claude/worktrees/
node_modules/

# Database dumps/backups — never commit real data (#317)
*.sql
*.sql.gz
*.dump
*.dump.gz
*.bak
*.backup

# Private-key and container-secret formats — never commit real key material
# (#317). Test/CI credentials are generated at runtime instead (see
# tests/Cluckwork.Api.IntegrationTests/Infrastructure/CluckworkWebApplicationFactory.cs).
*.pem
*.key
*.p12
*.pfx

# Generated test-run reports. `dotnet test --logger trx` writes these under a
# TestResults/ folder next to the project; nothing in the repo consumes them,
# and they embed the developer's machine name and absolute home path.
TestResults/
*.trx

.agents/skills
.claude/skills
# verify/ is Cluckwork's own skill, not an installed one: it knows this repo's
# stacks and ports, it is tracked (since #43), and gitignore does not apply to
# tracked files anyway - so the carve-out states the intent instead of leaving
# the file looking like an accident in every diff.
!.claude/skills/verify/
.codex/skills
skills-lock.json
scratchpad/
