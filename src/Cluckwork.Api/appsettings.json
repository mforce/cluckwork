{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Database": {
    "Provider": "Postgres"
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "cluckwork",
    "Audience": "cluckwork-api",
    "PublicKeyPem": "",
    "PrivateKeyPem": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 900
    },
    "TrustedProxies": []
  },
  "AllowedHosts": "*"
}
