<Project Sdk="Microsoft.NET.Sdk">

  <!-- #859: the module-edge rule as compiler feedback in Domain, Application, Infrastructure and Api.
       The compiler loads it, so it targets netstandard2.0. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Release tracking is for analyzers shipped as packages; this one ships with its consumers. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
