{
  // Local host ports for `aspire run` / `dotnet run`. These are the defaults
  // every clone gets, so a psql, redis-cli or browser URL stays valid across
  // restarts instead of moving each run.
  //
  // 5432 and 6379 are deliberately avoided: deploy/docker-compose.dev.yml
  // publishes those and keeps a separate data volume, so reusing them would
  // either fail the launch or point you at the other stack's database.
  //
  // Override per machine with user-secrets, per shell with an environment
  // variable (LocalPorts__Api=8080), or per run with an argument
  // (--LocalPorts:Api=8080). Set a value to empty to get Aspire's original
  // behaviour of assigning a random free port:
  //
  //   dotnet user-secrets --project src/Cluckwork.AppHost set "LocalPorts:Api" "8081"
  //   dotnet run --project src/Cluckwork.AppHost -- --LocalPorts:Api=
  //
  // The dashboard, its OTLP receiver and the resource service are AppHost host
  // endpoints rather than resources, so these keys cannot reach them. They are
  // pinned in Properties/launchSettings.json instead (dashboard 18888, OTLP
  // 18889, resource service 18890), asserted by AppHostModelTests. The host:port
  // is stable across runs; the dashboard's login token is minted per run, so
  // still take that from the CLI each time.
  "LocalPorts": {
    "Postgres": "5433",
    "Redis": "6380",
    "Api": "8080",
    "Web": "5173"
  }
}
