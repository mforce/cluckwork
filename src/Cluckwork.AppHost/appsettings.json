{
  // Local host ports for `aspire run` / `dotnet run`. An empty value means
  // Aspire assigns a random free host port, which is the default this file
  // ships and what docs/runbooks/aspire-local-development.md describes.
  //
  // Do not put a port here: it is a per-machine choice, and this file is
  // committed. Override per machine with user-secrets, per shell with an
  // environment variable (LocalPorts__Api=8080), or per run with an argument
  // (--LocalPorts:Api=8080). These are a developer convenience and never a
  // deployment input.
  //
  //   dotnet user-secrets --project src/Cluckwork.AppHost set "LocalPorts:Api" "8080"
  //
  // 5432 and 6379 collide with deploy/docker-compose.dev.yml, which keeps a
  // separate data volume. The dashboard and OTLP endpoints are not covered by
  // these keys and still move between runs.
  "LocalPorts": {
    "Postgres": "",
    "Redis": "",
    "Api": "",
    "Web": ""
  }
}
