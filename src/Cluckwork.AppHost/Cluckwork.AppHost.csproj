<Project Sdk="Aspire.AppHost.Sdk/13.5.0">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAspireHost>true</IsAspireHost>
    <!-- Package mode keeps ordinary/CI dotnet builds self-contained; Aspire
         13.5's ASPIRE010 only recommends CLI-bundle mode, while basic
         aspire run can consume the package-mode paths stamped in metadata. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>cluckwork-apphost-local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.NET.Sdk has no default item for appsettings.json, unlike the
         Web SDK, so without this the file never reaches the output directory.
         Running from source still finds it through the content root, so the
         copy is what makes it independent of the working directory and present
         in a published AppHost. AppHostConfigurationTests keeps the item. -->
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Cluckwork.Api/Cluckwork.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cluckwork.AppHost.Tests" />
  </ItemGroup>
</Project>
