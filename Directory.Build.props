<Project>

  <!-- Build settings every project in Cluckwork.sln shares. A project file
       still overrides any of these for itself, since MSBuild imports this file
       before the project. Package VERSIONS never go here: they live in
       Directory.Packages.props (#684). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- #146: emit a committed packages.lock.json per project, so restores are
         DETERMINISTIC — CI restores in locked mode, and a dependency cannot
         silently float to a different resolved version between a green local
         run and CI.

         It does NOT feed GitHub's dependency graph. An earlier revision of this
         comment claimed it did; that was wrong. The graph parses
         .csproj/.vbproj/.nuspec/.fsproj/packages.config for NuGet — never
         packages.lock.json — and does not derive NuGet transitives statically,
         so on manifests alone it sees only the direct PackageReferences
         (versioned in Directory.Packages.props), a fraction of the resolved
         closure — and not even those held in a Directory.Build.props such as
         tests/Directory.Build.props, which is no manifest to the graph; the
         tree-scoped vulnerable-package gate in ci.yml covers those at PR
         time. The transitive closure reaches the graph via the
         Dependency Submission API instead, in
         .github/workflows/dependency-submission.yml.

         Bumping or adding a package regenerates the lock file: commit it with
         the change. If CI fails with NU1004, run `dotnet restore` locally and
         commit the updated lock files. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
