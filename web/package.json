{
  "name": "cluckwork-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "verify:sw": "node scripts/verify-sw.mjs",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "fonts:subset": "node scripts/subset-inter-currency.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "node lint/node_modules/eslint/bin/eslint.js --suppressions-location lint/eslint-suppressions.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@mui/material": "^9.5.0",
    "i18next": "^27.1.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^8.5.1",
    "uqr": "^0.1.3",
    "workbox-expiration": "^7.4.1"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "postcss-selector-parser": "^7.1.8",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.12"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  }
}
