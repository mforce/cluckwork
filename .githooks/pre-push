#!/bin/sh
# pre-push: refuse pushes that change main, rewrite history, move a pushed tag,
# or land a branch under another name (#1171).
#
# Enable once per clone:   git config core.hooksPath .githooks
# Skip once:               git push --no-verify
#
# Git passes one line per ref on stdin: <local ref> <local sha> <remote ref>
# <remote sha>, so this reads what will actually be pushed and parses no
# command line. POSIX sh on purpose (see pre-commit).
#
# Not covered: `git push --mirror` deletes remote refs the clone does not have
# without sending their records (git skips a ref with no local peer), so
# deleting main that way never reaches this hook. The agent command guard
# refuses --mirror, and GitHub's protection of main refuses the deletion.
set -eu

remote=$1

refuse() {
  printf 'pre-push: refusing %s -> %s on %s: %s\n' "$local_ref" "$remote_ref" "$remote" "$1" >&2
  exit 1
}

is_zero() { case $1 in *[!0]*) return 1 ;; esac; }

# `git push origin HEAD` reports the local ref as HEAD; names are compared by the branch it names.
# current is empty on a detached HEAD (status 1); any other lookup failure refuses.
current=$(git symbolic-ref --quiet HEAD) || [ $? -eq 1 ] || { echo "pre-push: refusing: cannot read the current branch." >&2; exit 1; }

full_ref() { case $1 in refs/* | HEAD) echo "$1" ;; *) echo "refs/heads/$1" ;; esac; }

# A remote.<name>.push refspec maps the branch on purpose (Paseo PR checkouts
# push HEAD:refs/heads/<pr-branch> from a suffixed local branch). Short names
# are read as branches; a leading + is ignored here because the history check
# above already refuses a forced update. A HEAD mapping covers only the
# checked-out branch, never a detached HEAD. Wildcard refspecs are not
# supported and never match.
configured() {
  specs=$(git config --get-all "remote.$remote.push") || return 1
  while IFS= read -r spec; do
    spec=${spec#+}
    [ "$(full_ref "${spec#*:}")" = "$remote_ref" ] || continue
    src=$(full_ref "${spec%%:*}")
    case $src in
      HEAD) [ "$local_ref" = "$current" ] && return 0 ;; # a detached local ref stays HEAD
      "$local_ref") return 0 ;;
    esac
  done <<EOF
$specs
EOF
  return 1
}

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = refs/heads/main ]; then
    refuse "main changes only through a merged PR. Run \`git switch -c <type>/<topic>\`, then push that branch."
  fi
  is_zero "$local_sha" && continue # deleting another branch
  case $remote_ref in refs/tags/*)
    if ! is_zero "$remote_sha" && [ "$remote_sha" != "$local_sha" ]; then
      refuse "a pushed tag is never moved or replaced, even when its commit moves forward. Push a new tag instead."
    fi
  esac
  [ "$local_ref" = HEAD ] && [ -n "$current" ] && local_ref=$current
  if ! is_zero "$remote_sha" && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    refuse "not a fast-forward (a force push, or the remote has commits you lack). Fetch, merge, and push a new commit."
  fi
  if [ "$local_ref" != "$remote_ref" ] && ! configured; then
    refuse "the local and remote names differ, a src:dst push (#900). Run \`git branch --show-current\`, then \`git push -u origin <that-branch>\`."
  fi
done
exit 0
