# Copy to deploy/.env and replace every value before running docker compose.
# CLUCKWORK_HOST is both the traefik router host AND the pinned AllowedHosts
# value (#144): requests with any other Host header are rejected 400. Loopback
# stays allowed so the container healthcheck works.
CLUCKWORK_HOST=cluckwork.local
POSTGRES_DB=cluckwork
POSTGRES_USER=cluckwork
POSTGRES_PASSWORD=replace-with-a-strong-password
Jwt__Issuer=cluckwork
Jwt__Audience=cluckwork-api
Jwt__PublicKeyPem="-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----"
Jwt__PrivateKeyPem="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"

# Startup seed (single-farm MVP). The app seeds one default account + this admin
# user on boot — but ONLY if both values below are set. There is no fallback
# credential. Leave blank to skip seeding. Password MUST meet the identity policy
# (>=12 chars, upper/lower/digit/symbol); if it doesn't, seeding is skipped and
# an error is logged (the app still starts) — so replace the placeholder below.
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=replace-with-a-strong-password
# Optional second login WITHOUT the Admin role (#73) — for testing the worker
# experience. Both must be set or the worker seed is skipped.
# Seed__WorkerEmail=worker@example.com
# Seed__WorkerPassword=replace-with-a-strong-password
# Set to false to disable startup seeding entirely.
# Seed__Enabled=true
# Set to false to skip applying EF migrations on startup.
# Database__MigrateOnStartup=true

# Auth rate limiting (#143): login and refresh are throttled separately per
# client IP (login strict, refresh looser so normal session traffic behind one
# NAT doesn't starve login). The client IP is read from X-Forwarded-For only for
# requests arriving from the trusted proxy network below (traefik's compose
# network; CIDR notation, /32 for a single address).
# TRUSTED_PROXY_CIDR=172.16.0.0/12
# RateLimiting__Login__PermitLimit=10
# RateLimiting__Login__WindowSeconds=900
# RateLimiting__Refresh__PermitLimit=60
# RateLimiting__Refresh__WindowSeconds=900

# Browser error reports (#217): the anonymous /api/v1/client-errors endpoint is
# throttled per client IP so it can't be used to flood the log. The default is
# enough for a genuinely crashing screen, tiny for an abuser.
# RateLimiting__ClientErrors__PermitLimit=10
# RateLimiting__ClientErrors__WindowSeconds=300

# OpenTelemetry export (#214 traces, #215 metrics). Both signals go over OTLP
# to the SAME endpoint, ONLY when it is set; leave it unset to keep telemetry
# in-process (no exporter, no overhead). A malformed endpoint or protocol
# fails at startup — fix the value, don't ignore the crash loop.
# Traces: HTTP requests + EF Core queries (health probes excluded).
# Metrics (meter set): ALL built-in ASP.NET Core meters — hosting
# (http.server.request.duration), Kestrel, routing, rate limiting,
# authentication/authorization/Identity, memory pool — plus .NET runtime
# (GC/threads/exceptions), Npgsql (connections/commands), and EF Core
# (Microsoft.EntityFrameworkCore). All low-cardinality; request-duration
# histograms INCLUDE health probes (the metrics side has no per-request
# filter). Temporality (cumulative) and the 60s export interval are SDK
# defaults — override per vendor via OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE
# and OTEL_METRIC_EXPORT_INTERVAL, no code change needed.
# Protocol is 'grpc' (default, usually port 4317) or 'http/protobuf' (usually
# 4318 — most SaaS vendors). For http/protobuf give the BASE url (no /v1/traces
# — the app appends the signal path itself). Headers carry vendor auth,
# comma-separated key=value pairs.
# Otlp__Endpoint=https://otlp.example.com:4317
# Otlp__Protocol=grpc
# Otlp__Headers=Authorization=Basic replace-me
